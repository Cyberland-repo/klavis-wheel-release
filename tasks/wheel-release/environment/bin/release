#!/usr/bin/env python3
"""Shipped releaser: packs every module and records the absolute build path."""

import json
import sys
import zipfile
from pathlib import Path

root = Path(sys.argv[1]).resolve()
dist = root / "dist"
dist.mkdir(exist_ok=True)
wheel = dist / "app-0.1.0-py3-none-any.whl"
with zipfile.ZipFile(wheel, "w") as archive:
    for path in sorted(root.rglob("*.py")):
        if "dist" in path.parts:
            continue
        archive.write(path, path.relative_to(root).as_posix())
(dist / "RELEASE.json").write_text(json.dumps({"builtFrom": str(root)}) + "\n")
